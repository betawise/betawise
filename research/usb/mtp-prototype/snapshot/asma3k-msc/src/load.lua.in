local machine=manager.machine;local cpu=machine.devices[':maincpu'];local m=cpu.spaces.program
local out=@OUT@;local frame,phase=0,'wait';local snapshot,registers={},{}
local names={'D0','D1','D2','D3','D4','D5','D6','D7','A0','A1','A2','A3','A4','A5','A6','SP','PC','SR'}
local original_imr;local taps={};local rom_gpio,rom_usb,rom_total,seen=0,0,0,{}
local function fileexists(p)local f=io.open(p,'r');if f then f:close();return true end;return false end
local function save(p,t)local f=assert(io.open(out..'/'..p,'w'));f:write(t);f:close()end
local function load(p,address)local f=assert(io.open(p,'rb'));local s=f:read('*a');f:close();for i=1,#s do m:write_u8(address+i-1,s:byte(i))end end
emu.register_frame_done(function()
 frame=frame+1
 local ok,err=pcall(function()
 if phase=='wait' then
  assert(frame<1800,'main-ROM readiness deadline')
  local pc=cpu.state.PC.value;local sp=cpu.state.SP.value
  if pc<0x4c0000 or pc>=0x500000 or sp<0x1000 or sp>=0x40000 or (m:read_u32(0xfffff304)&0xffffff)==0xffffff or(cpu.state.SR.value&0x700)~=0 then return end
  for _,r in ipairs(names)do registers[r]=cpu.state[r].value end
  for a=0,0x3ffff do snapshot[a]=m:read_u8(a)end
  -- Preserve CPU/firmware RAM. Only this disposable run's RAM is overwritten.
  load(@BINARY@,0x30000);for a=@BSS@,0x3dfff do m:write_u8(a,0)end
  for a=0x3e000,0x3e100 do m:write_u8(a,0)end
  load(@DISK@,0x20000)
  taps[#taps+1]=m:install_write_tap(0xfffff420,0xfffff421,'msc_ownership_gpio',function(a,v,mask)
   if phase=='running'and cpu.state.PC.value>=0x400000 then rom_gpio=rom_gpio+1 end
  end)
  taps[#taps+1]=m:install_read_tap(0x4c0000,0x4fffff,'msc_ownership_rom',function(a,v,mask)
   if phase=='running'then local pc=cpu.state.PC.value;rom_total=rom_total+1;if(pc>=0x4e4e00 and pc<0x4e6c00)or pc==0x4cc4be then rom_usb=rom_usb+1;seen[pc]=(seen[pc]or 0)+1 end end
  end)
  original_imr=m:read_u32(0xfffff304);m:write_u32(0xfffff304,original_imr&~0x100000)
  cpu.state.SP.value=0x3dffc;cpu.state.SR.value=0x2000;cpu.state.PC.value=@ENTRY@
  phase='starting';return
 elseif phase=='starting'then
  if m:read_u32(0x3e000)==0x4d534331 then save('ready','ready\n');phase='running'end
 elseif phase=='running'then
  assert(frame<@DEADLINE@,'prototype deadline')
  if fileexists(out..'/stop')then local t={};for a=0,71,4 do t[#t+1]=tostring(m:read_u32(0x3e000+a))end;save('debug.json','{"pc":'..cpu.state.PC.value..',"sp":'..cpu.state.SP.value..',"sr":'..cpu.state.SR.value..',"t":['..table.concat(t,',')..']}');m:write_u32(0x3e030,1);phase='stopping'end
 elseif phase=='stopping'then
  if m:read_u32(0x3e034)~=0x444f4e45 then return end
  local t={};for a=0,71,4 do t[#t+1]=tostring(m:read_u32(0x3e000+a))end
  local hits={};for pc,n in pairs(seen)do hits[#hits+1]=string.format('"%x":%d',pc,n)end
  save('guest.json','{"telemetry":['..table.concat(t,',')..'],"rom_gpio_writes":'..rom_gpio..',"rom_usb_reads":'..rom_usb..',"rom_reads":'..rom_total..',"hits":{'..table.concat(hits,',')..'}}\n')
  for _,tap in ipairs(taps)do tap:remove()end
  cpu.state.SR.value=0x2700
  m:write_u32(0xfffff304,original_imr)
  for a=0,0x3ffff do m:write_u8(a,snapshot[a])end
  for _,r in ipairs(names)do cpu.state[r].value=registers[r]end
  save('restored','RAM and guest registers restored\n');print('PASS MSC guest returned ownership and restored RAM/registers');phase='restored'
 elseif phase=='restored'then
  if fileexists(out..'/quit')then machine:exit()end
 end
 end)
 if not ok then print('FAIL MSC loader '..tostring(err));save('failure',tostring(err));machine:exit()end
end)
