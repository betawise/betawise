 }
 void alphasneo_state::ram_w(offs_t offset,u16 data,u16 mask) {
     u32 a=offset<<1;
-    if(a>=0x0000f000 && a<0x00010000) {vz_w((a-0xf000)>>1,data,mask);return;}
